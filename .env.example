# Vast.ai SSH Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Your Vast.ai instance details
export VASTAI_HOST="root@YOUR_VASTAI_IP"
export VASTAI_PORT="22"  # Update with your SSH port

# API Keys for LLM frameworks
export VLLM_API_KEY="your-vllm-api-key-here"
export SGLANG_API_KEY="your-sglang-api-key-here"
export TENSORRT_API_KEY="your-tensorrt-api-key-here"

# Optional: Model configuration
export VLLM_MODEL="deepseek-ai/DeepSeek-R1-Distill-Llama-8B"
export SGLANG_MODEL="deepseek-ai/DeepSeek-R1-Distill-Llama-8B"
export TENSORRT_MODEL="deepseek-ai/DeepSeek-R1-Distill-Llama-8B"

# Optional: Port configuration
export SGLANG_PORT="31836"
export TENSORRT_PORT="8000"
